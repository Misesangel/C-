    public class Dungeon
    {
        private int currentRoomIndex = 0;
        private const int TotalRooms = 6;
        private string[] roomDescriptions = new string[]
        {
            "A damp, dark entryway smelling of moss and decay.",
            "An abandoned guardroom with broken stone tables.",
            "A narrow winding corridor where the walls feel uncomfortably close.",
            "A vast, underground library filled with rotting manuscripts.",
            "The torture chambers. Skeletons hang loosely from iron shackles.",
            "The central sanctum. A massive, gold-embossed throne sits in the darkness."
        };

        public bool HasClearedDungeon => currentRoomIndex > TotalRooms;

        public void NextRoom()
        {
            currentRoomIndex++;
        }

        public void DisplayCurrentRoom()
        {
            if (currentRoomIndex == 0)
            {
                Console.WriteLine("You stand before the grand doors of the dungeon. Step forward to begin.");
                return;
            }

            if (currentRoomIndex <= TotalRooms)
            {
                Console.ForegroundColor = ConsoleColor.Magenta;
                Console.WriteLine($"[ ROOM {currentRoomIndex} / {TotalRooms} ]");
                Console.ResetColor();
                Console.WriteLine(roomDescriptions[currentRoomIndex - 1]);
            }
        }

        public Enemy GetCurrentEnemy()
        {
            switch (currentRoomIndex)
            {
                case 1: return new Enemy("Feral Goblin", 30, 8, 15);
                case 2: return new Enemy("Skeletal Guard", 45, 12, 25);
                case 4: return new Enemy("Cursed Shadow", 60, 15, 40);
                case 6: return new Enemy("Demon Lord Malakor", 120, 22, 100);
                case 8: return new Enemy("Demon Lord Malakor", 120, 22, 200);

                default: return null;
            }
        }
    }

